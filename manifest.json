{
  "manifest_version": 3,
  "name": "tweetmuff",
  "version": "1.0.8",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/takagiy/tweetmuff",
  "description": "Hides X (Twitter) posts that contain your muted words, without a trace. Uses your existing X mute list.",
  "permissions": ["storage"],
  "action": { "default_popup": "pages/popup.html", "default_title": "tweetmuff" },
  "options_ui": { "page": "pages/options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/core.js", "src/main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
